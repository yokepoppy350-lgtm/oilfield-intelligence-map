        {
          "title": "智能方法介入的位置",
          "html": "<p>用归一化伽马、电阻率和孔隙度教学特征学习岩性标签，在留出采样点上比较参考与预测。</p><p>输入输出：三条归一化测井特征 → 岩性类别。评价：准确率与混淆矩阵。</p>"
        },
        {
          "title": "数据与适用范围",
          "html": "<p>全部为固定种子的教学合成数据。合成单井采样点交错留出只演示流程，不代表跨井泛化能力。</p>"
        }
      ]
    },
    "workflow": {
      "label": "案例流程",
      "title": "从专业问题到可复核结果",
      "lead": [
        "用归一化伽马、电阻率和孔隙度教学特征学习岩性标签，在留出采样点上比较参考与预测。"
      ],
      "steps": [
        {
          "name": "明确任务与样本",
          "do": "能否结合多条测井特征辅助识别岩性？",
          "effect": "三条归一化测井特征 → 岩性类别",
          "trap": "先确认目标、标签和单位，不能把相关关系直接解释为因果。"
        },
        {
          "name": "划分训练与留出样本",
          "do": "固定种子生成数据，先划分再建模。除时序与图像任务外，编号模5为0的48条留出。",
          "effect": "训练样本用于学习；留出样本只用于计算指标。",
          "trap": "时序使用前60天训练、后30天留出；裂缝图像使用独立训练样本与独立测试图。"
        },
        {
          "name": "拟合与预测",
          "do": "训练数据中学习七近邻分类，把模型应用于留出样本。",
          "effect": "每个留出对象对应一个预测值或类别。",
          "trap": "合成单井采样点交错留出只演示流程，不代表跨井泛化能力。"
        },
        {
          "name": "比较基线与复核结果",
          "do": "在同一批测试对象上计算准确率与混淆矩阵，同时显示简单基线。调整控件后查看当前输入的结果。",
          "effect": "图形、指标与可导出的结果一致。",
          "trap": "教学数据表现不能作为实际油田效果或安全施工依据。"
        }
      ],
      "diagram": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 190\" role=\"img\" aria-label=\"三条归一化测井特征 → 岩性类别\"><rect x=\"5\" y=\"25\" width=\"220\" height=\"115\" fill=\"#233d30\"/><rect x=\"270\" y=\"25\" width=\"220\" height=\"115\" fill=\"#384438\"/><rect x=\"535\" y=\"25\" width=\"220\" height=\"115\" fill=\"#673c2d\"/><g fill=\"#f0eee2\" font-size=\"18\" font-family=\"sans-serif\"><text x=\"20\" y=\"58\">专业输入</text><text x=\"20\" y=\"92\">三条归一化测井特征</text><text x=\"285\" y=\"58\">从训练样本学习</text><text x=\"285\" y=\"92\">七近邻分类</text><text x=\"550\" y=\"58\">预测与复核</text><text x=\"550\" y=\"92\">岩性类别</text></g><path d=\"M230 80H262M255 73L262 80L255 87M495 80H527M520 73L527 80L520 87\" fill=\"none\" stroke=\"#857765\" stroke-width=\"3\"/><text x=\"10\" y=\"177\" font-size=\"15\" fill=\"#65715e\">数据 → 模型 → 结果；测试样本全程独立于模型拟合。</text></svg>"
    },
