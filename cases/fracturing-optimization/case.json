    "workflow": {
      "label": "案例流程",
      "title": "从专业问题到可复核结果",
      "lead": [
        "从合成施工样本拟合响应代理模型，在25组离散组合中筛选预算内候选。"
      ],
      "steps": [
        {
          "name": "明确任务与样本",
          "do": "预算有限时，液量与砂量如何组合？",
          "effect": "液量、砂量等级 → 响应指数",
          "trap": "先确认目标、标签和单位，不能把相关关系直接解释为因果。"
        },
        {
          "name": "划分训练与留出样本",
          "do": "固定种子生成数据，先划分再建模。除时序与图像任务外，编号模5为0的48条留出。",
          "effect": "训练样本用于学习；留出样本只用于计算指标。",
          "trap": "时序使用前60天训练、后30天留出；裂缝图像使用独立训练样本与独立测试图。"
        },
        {
          "name": "拟合与预测",
          "do": "训练数据中学习回归与约束搜索，把模型应用于留出样本。",
          "effect": "每个留出对象对应一个预测值或类别。",
          "trap": "液量与砂量仅使用归一化等级，未经现场机制或施工安全校准。"
        },
        {
          "name": "比较基线与复核结果",
          "do": "在同一批测试对象上计算测试MAE与可行候选，同时显示简单基线。调整控件后查看当前输入的结果。",
          "effect": "图形、指标与可导出的结果一致。",
          "trap": "教学数据表现不能作为实际油田效果或安全施工依据。"
        }
      ],
