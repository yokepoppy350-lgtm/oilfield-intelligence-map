        },
        {
          "name": "比较基线与复核",
          "do": "在相同测试对象或候选集上计算模型和基线；调整控件后导出逐条结果。",
          "effect": "指标、主图、导出表均由同一次计算生成。",
          "trap": "只有在独立现场数据验证后才能讨论实际适用性。",
          "diagram": "<svg viewBox=\"0 0 760 180\" role=\"img\" aria-label=\"默认计算指标对照\"><text x=\"0\" y=\"30\" fill=\"#173b52\">留出 MAE</text><rect x=\"255\" y=\"12\" width=\"9.7\" height=\"26\" fill=\"#216d89\"/><text x=\"655\" y=\"30\" fill=\"#536777\">1.48 指数</text><text x=\"0\" y=\"82\" fill=\"#173b52\">均值基线 MAE</text><rect x=\"255\" y=\"64\" width=\"32.5\" height=\"26\" fill=\"#bf703b\"/><text x=\"655\" y=\"82\" fill=\"#536777\">4.96 指数</text><text x=\"0\" y=\"134\" fill=\"#173b52\">当前预测</text><rect x=\"255\" y=\"116\" width=\"390.0\" height=\"26\" fill=\"#71843d\"/><text x=\"655\" y=\"134\" fill=\"#536777\">59.56 指数</text></svg>"
