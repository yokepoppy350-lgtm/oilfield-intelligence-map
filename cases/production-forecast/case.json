    "workflow": {
      "label": "案例流程",
      "title": "从专业问题到可复核结果",
      "lead": [
        "以前60天的合成产量拟合对数线性回归，后30天完整留出，与末值保持基线比较。"
      ],
      "steps": [
        {
          "name": "明确任务与样本",
          "do": "只有过去的产量记录时，未来趋势怎样估计？",
          "effect": "历史时间序列 → 未来产量指数",
          "trap": "先确认目标、标签和单位，不能把相关关系直接解释为因果。"
        },
        {
          "name": "划分训练与留出样本",
          "do": "固定种子生成数据，先划分再建模。除时序与图像任务外，编号模5为0的48条留出。",
          "effect": "训练样本用于学习；留出样本只用于计算指标。",
          "trap": "时序使用前60天训练、后30天留出；裂缝图像使用独立训练样本与独立测试图。"
        },
        {
          "name": "拟合与预测",
          "do": "训练数据中学习对数线性回归，把模型应用于留出样本。",
          "effect": "每个留出对象对应一个预测值或类别。",
          "trap": "模型只适合此教学递减过程，未纳入停井、措施或生产制度变化。"
        },
        {
          "name": "比较基线与复核结果",
          "do": "在同一批测试对象上计算留出时段MAE，同时显示简单基线。调整控件后查看当前输入的结果。",
          "effect": "图形、指标与可导出的结果一致。",
          "trap": "教学数据表现不能作为实际油田效果或安全施工依据。"
        }
      ],
