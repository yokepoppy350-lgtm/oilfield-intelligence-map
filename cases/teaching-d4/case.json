    "workflow": {
      "label": "案例流程",
      "title": "钻具失效预测的计算流程",
      "lead": [
        "用正常振动序列学习预测器，检查间歇冲击的检出与误报。"
      ],
      "steps": [
        {
          "name": "定义输入与参考",
          "do": "用正常振动序列学习预测器，检查间歇冲击的检出与误报。",
          "effect": "本例输入：钻具振动时序、一步预测残差；输出：失效前兆告警",
          "trap": "合成参考只定义此教学任务，不作为现场真值。",
          "diagram": "<table><caption>默认条件下的评价对象预览（可在演示导出完整表）</caption><thead><tr><th>sample</th><th>value</th><th>reference</th><th>prediction</th></tr></thead><tbody><tr><td>0</td><td>50</td><td>0</td><td>0</td></tr><tr><td>1</td><td>49.792</td><td>0</td><td>0</td></tr><tr><td>2</td><td>49.352</td><td>0</td><td>0</td></tr><tr><td>3</td><td>49.588</td><td>0</td><td>0</td></tr><tr><td>4</td><td>49.841</td><td>0</td><td>0</td></tr></tbody></table>"
        },
        {
          "name": "准备数据与划分",
          "do": "97个正常点训练，128个独立测试点；事件区间52—77，尖峰型仅每5点为参考异常。",
          "effect": "固定种子 438；同一条件可重复。",
          "trap": "先确定评价对象，测试参考不参与模型学习或阈值拟合。",
          "diagram": "<svg viewBox=\"0 0 760 120\" role=\"img\" aria-label=\"训练与评价分开\"><text x=\"10\" y=\"25\" fill=\"#173b52\">训练 97；独立评价 128（默认条件）</text><rect x=\"10\" y=\"45\" width=\"310.4\" height=\"35\" fill=\"#216d89\"/><rect x=\"320.4\" y=\"45\" width=\"409.6\" height=\"35\" fill=\"#bf703b\"/><text x=\"10\" y=\"110\" fill=\"#536777\">蓝色用于学习；橙色只用于评价，不参与拟合。</text></svg>"
        },
        {
          "name": "计算与解释",
          "do": "正常序列AR(1)预测 + 残差阈值；预测=a+b×上一点；阈值=训练残差均值+倍数×标准差；固定|值−50|>8为基线。F1=2TP/(2TP+FP+FN)。",
